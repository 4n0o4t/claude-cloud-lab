+/* ============ 3D 圆桌:俯视角投影 ============
+ * 不用 WebGL:桌面是椭圆(把圆按 tilt 压扁),座位仍是普通按钮,按纵深缩放、排层级。
+ * 容器宽高比 ARENA_3D_ASPECT,x 是宽度百分比、y 是高度百分比。
+ * frontSeat:转到正前方(离镜头最近)的座位;玩家看自己的座位在近处,旁观时 1 号在远端正中,与 2D 一致。 */
+export const ARENA_3D_ASPECT = 16 / 9
+
+export function arena3dGeometry(total) {
+  // 人多时桌面立起来一点,两侧座位纵向不至于挤在一起
+  const tilt = total > 12 ? 0.5 : total > 8 ? 0.46 : 0.42
+  const rx = 42
+  return { rx, ry: rx * tilt * ARENA_3D_ASPECT, tilt }
+}
+
+function seatAngle3d(index, total, frontSeat) {
+  const n = Math.max(total, 1)
+  const offset = frontSeat ? Math.PI - (2 * Math.PI * (frontSeat - 1)) / n : 0
+  return seatAngle(index, total) + offset
+}
+
+/* 返回 { x, y, depth };depth 0 = 最远(上),1 = 最近(下) */
+export function getSeatPose3d(index, total, frontSeat = null) {
+  const { rx, ry } = arena3dGeometry(total)
+  const a = seatAngle3d(index, total, frontSeat)
+  return { x: 50 + rx * Math.cos(a), y: 50 + ry * Math.sin(a), depth: (Math.sin(a) + 1) / 2 }
+}
+
+export function getPlayerPositionStyle3d(index, total, frontSeat = null) {
+  const { x, y, depth } = getSeatPose3d(index, total, frontSeat)
+  return {
+    left: `${x}%`,
+    top: `${y}%`,
+    zIndex: 4 + Math.round(depth * 20),
+    '--seat-scale': (0.8 + 0.3 * depth).toFixed(3),
+    '--seat-dim': (0.78 + 0.22 * depth).toFixed(3),
+  }
+}
+
+/* 3D 投票弧线:viewBox 0 0 100 (100/ASPECT),起止点缩进到盘内,向外鼓出避开桌心文字 */
+export function getVoteArc3d(voter, target, total, frontSeat = null) {
+  const h = 100 / ARENA_3D_ASPECT
+  const shrink = 0.86
+  const p = (seat) => {
+    const { x, y } = getSeatPose3d(seat - 1, total, frontSeat)
+    return { x: 50 + (x - 50) * shrink, y: (50 + (y - 50) * shrink) * (h / 100) }
+  }
+  const a = p(Number(voter))
+  const b = p(Number(target))
+  const c = { x: 50, y: h / 2 }
+  const mx = (a.x + b.x) / 2
+  const my = (a.y + b.y) / 2
+  const dist = Math.hypot(b.x - a.x, b.y - a.y) || 1
+  // 弧线朝远离桌心的一侧鼓出,绕开桌心的发言/票数;正对面两座(连线过桌心)固定往右绕
+  let nx = -(b.y - a.y) / dist
+  let ny = (b.x - a.x) / dist
+  const side = (mx - c.x) * nx + (my - c.y) * ny
+  if (side < 0 || (Math.abs(side) < 1e-6 && nx < 0)) { nx = -nx; ny = -ny }
+  const bulge = Math.min(dist * 0.42, 16) // 封顶:正对面的长弦不至于绕出桌外
+  const qx = mx + nx * bulge
+  const qy = my + ny * bulge - 2 // 再往上抬一点,像从桌面上方划过
+  return `M${a.x.toFixed(2)},${a.y.toFixed(2)} Q${qx.toFixed(2)},${qy.toFixed(2)} ${b.x.toFixed(2)},${b.y.toFixed(2)}`
+}
+
 /* 发言气泡快照(gameSession 依赖) */
 export function buildSpeechBubble(seat, content) {
   return { show: true, seat, content }
