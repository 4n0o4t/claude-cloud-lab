+/* ============ 3D 圆桌 ============
+ * 质感对齐宣传片:台面只留两圈发丝金线,靠光而不是靠填色撑起立体感;
+ * 座位是大号圆章,按纵深缩放;状态用辉光表达;投票是发光实线弧,出现时从投票者描向目标。 */
+.arena-wrap.is-3d { isolation: isolate; }
+/* 阶段氛围光:白昼暖、夜里冷蓝、投票时一点血色 */
+.arena-glow {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+  background:
+    radial-gradient(ellipse 46% 40% at 50% 54%, rgba(201, 162, 74, 0.10), transparent 70%),
+    radial-gradient(ellipse 70% 60% at 50% 50%, rgba(90, 60, 40, 0.16), transparent 75%);
+  transition: opacity var(--duration-normal) var(--ease-out);
+}
+.arena-wrap.is-night .arena-glow {
+  background:
+    radial-gradient(ellipse 46% 40% at 50% 52%, rgba(127, 156, 196, 0.16), transparent 70%),
+    radial-gradient(ellipse 80% 70% at 50% 30%, rgba(30, 50, 90, 0.30), transparent 75%);
+}
+.arena-wrap.is-vote .arena-glow {
+  background:
+    radial-gradient(ellipse 46% 40% at 50% 54%, rgba(165, 50, 42, 0.12), transparent 70%),
+    radial-gradient(ellipse 70% 60% at 50% 50%, rgba(90, 40, 30, 0.16), transparent 75%);
+}
+
+.arena.is-3d {
+  width: min(100%, 1120px, calc((100vh - 220px) * 16 / 9));
+  aspect-ratio: 16 / 9;
+  container-type: inline-size;
+  /* 圆章直径随桌宽和人数变化 */
+  --disc: clamp(46px, calc(var(--disc-pct, 7.6) * 1cqw), 88px);
+}
+.arena.is-3d::before,
+.arena.is-3d::after { display: none; }
+.table-top {
+  position: absolute;
+  left: calc(50% - var(--tt-rx));
+  right: calc(50% - var(--tt-rx));
+  top: calc(50% - var(--tt-ry));
+  bottom: calc(50% - var(--tt-ry));
+  border-radius: 50%;
+  border: 1.5px solid rgba(201, 162, 74, 0.26);
+  background: radial-gradient(ellipse at 50% 46%, rgba(201, 162, 74, 0.05), transparent 64%);
+  box-shadow: 0 0 40px rgba(201, 162, 74, 0.05), inset 0 0 60px rgba(0, 0, 0, 0.25);
+  pointer-events: none;
+}
+.tt-ring {
+  position: absolute;
+  inset: 22.5%;
+  border-radius: 50%;
+  border: 1px solid rgba(201, 162, 74, 0.14);
+}
+.tt-ring.is-inner { inset: 38%; border-color: rgba(201, 162, 74, 0.07); }
+.arena.is-3d.is-night .table-top { border-color: rgba(170, 190, 220, 0.24); }
+.arena.is-3d.is-night .tt-ring { border-color: rgba(170, 190, 220, 0.12); }
+
+/* 座位:大号圆章 */
+.arena.is-3d .seat-node {
+  transform: translate(-50%, -50%) scale(var(--seat-scale, 1));
+  filter: brightness(var(--seat-dim, 1));
+  gap: 10px;
+  transition: transform 220ms var(--ease-out), filter 220ms var(--ease-out);
+}
+.arena.is-3d .sn-disc {
+  position: relative;
+  width: var(--disc);
+  height: var(--disc);
+  border: 1.5px solid rgba(236, 227, 210, 0.22);
+  background: radial-gradient(circle at 50% 32%, #2b241f 0%, #17120f 70%);
+  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.06);
+  animation: seatIn 620ms var(--ease-out) backwards; /* 不用 both:结束后不能占住 transform,否则选中态的 scale 失效 */
+  animation-delay: calc(var(--seat-i, 0) * 45ms);
+}
+.arena.is-3d .sn-num { font-size: calc(var(--disc) * 0.38); color: var(--color-text); }
+.arena.is-3d .sn-label { font-size: 11px; letter-spacing: 0.32em; }
+/* 13 人以上两侧太密:号码已在圆章上,标签只留“你”和“殁” */
+.arena.is-3d.is-crowded .seat-node:not(.is-me):not(.is-dead) .sn-label { visibility: hidden; }
+.arena.is-3d .sn-badge { top: -4px; right: -2px; min-width: 24px; height: 24px; font-size: 13px; box-shadow: 0 0 14px rgba(165, 50, 42, 0.7); }
+/* 座位落在台面上的影子 */
+.arena.is-3d .seat-node::before {
+  content: '';
+  position: absolute;
+  top: calc(var(--disc) * 0.86);
+  left: 50%;
+  width: calc(var(--disc) * 0.92);
+  height: calc(var(--disc) * 0.22);
+  transform: translateX(-50%);
+  border-radius: 50%;
+  background: rgba(0, 0, 0, 0.7);
+  filter: blur(6px);
+  z-index: -1;
+}
+/* 台面上的光斑:发言、等待、被选中时座位下方亮起 */
+.arena.is-3d .seat-node::after {
+  content: '';
+  position: absolute;
+  top: calc(var(--disc) * 0.7);
+  left: 50%;
+  width: calc(var(--disc) * 1.8);
+  height: calc(var(--disc) * 0.55);
+  transform: translateX(-50%);
+  border-radius: 50%;
+  background: radial-gradient(ellipse, var(--seat-light, transparent), transparent 70%);
+  z-index: -2;
+  opacity: 0;
+  transition: opacity 260ms var(--ease-out);
+}
+.arena.is-3d .seat-node:hover,
+.arena.is-3d .seat-node:focus-visible {
+  transform: translate(-50%, calc(-50% - 8px)) scale(var(--seat-scale, 1));
+  filter: none;
+}
+.arena.is-3d .seat-node:hover .sn-disc { border-color: rgba(201, 162, 74, 0.6); }
+
+.arena.is-3d .seat-node.is-me .sn-disc { border-color: var(--color-gold); }
+.arena.is-3d .seat-node.is-speaking {
+  transform: translate(-50%, calc(-50% - 10px)) scale(var(--seat-scale, 1));
+  filter: none;
+  --seat-light: rgba(201, 162, 74, 0.38);
+}
+.arena.is-3d .seat-node.is-speaking .sn-disc {
+  border: 2px solid var(--color-gold);
+  box-shadow: 0 0 0 4px rgba(201, 162, 74, 0.12), 0 0 46px rgba(201, 162, 74, 0.55), 0 14px 30px rgba(0, 0, 0, 0.6);
+}
+.arena.is-3d .seat-node.is-selected,
+.arena.is-3d .seat-node.is-waiting,
+.arena.is-3d .seat-node.is-paired { filter: none; }
+.arena.is-3d .seat-node.is-selected { --seat-light: rgba(201, 162, 74, 0.32); }
+.arena.is-3d .seat-node.is-waiting,
+.arena.is-3d .seat-node.is-paired { --seat-light: rgba(165, 50, 42, 0.36); }
+.arena.is-3d .seat-node.is-speaking::after,
+.arena.is-3d .seat-node.is-selected::after,
+.arena.is-3d .seat-node.is-waiting::after,
+.arena.is-3d .seat-node.is-paired::after,
+.arena.is-3d .seat-node.is-vote-lead::after { opacity: 1; }
