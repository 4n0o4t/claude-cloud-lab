+/* ============ 3D 圆桌 ============ */
+.arena.is-3d {
+  width: min(100%, 1080px, calc((100vh - 240px) * 16 / 9));
+  aspect-ratio: 16 / 9;
+}
+.arena.is-3d::before,
+.arena.is-3d::after { display: none; }
+.table-top {
+  position: absolute;
+  left: calc(50% - var(--tt-rx));
+  right: calc(50% - var(--tt-rx));
+  top: calc(50% - var(--tt-ry));
+  bottom: calc(50% - var(--tt-ry));
+  border-radius: 50%;
+  border: var(--border-hair) solid var(--color-border-strong);
+  background:
+    radial-gradient(ellipse at 50% 38%, rgba(201, 162, 74, 0.07), transparent 62%),
+    radial-gradient(ellipse at 50% 50%, var(--color-surface-1), transparent 100%);
+  /* 台面厚度 + 落在地上的影子 */
+  box-shadow:
+    0 10px 0 -2px rgba(0, 0, 0, 0.35),
+    0 10px 0 -1px var(--color-border),
+    0 40px 80px rgba(0, 0, 0, 0.55);
+  pointer-events: none;
+  transition: background var(--duration-normal) var(--ease-out);
+}
+.tt-ring {
+  position: absolute;
+  inset: 22.5%;
+  border-radius: 50%;
+  border: var(--border-hair) solid var(--color-border);
+  opacity: 0.7;
+}
+.arena.is-3d.is-night .table-top {
+  background:
+    radial-gradient(ellipse at 50% 30%, rgba(127, 156, 196, 0.10), transparent 62%),
+    radial-gradient(ellipse at 50% 50%, var(--color-surface-1), transparent 100%);
+}
+.arena.is-3d .seat-node {
+  transform: translate(-50%, -50%) scale(var(--seat-scale, 1));
+  filter: brightness(var(--seat-dim, 1));
+  transition: transform var(--duration-fast) var(--ease-out), filter var(--duration-fast) var(--ease-out);
+}
+.arena.is-3d .seat-node:hover,
+.arena.is-3d .seat-node:focus-visible {
+  transform: translate(-50%, calc(-50% - 6px)) scale(var(--seat-scale, 1));
+  filter: none;
+}
+.arena.is-3d .seat-node.is-speaking,
